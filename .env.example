# ==============================================================================
# PARAMETRI PUBBLICI & CONFIGURAZIONE AMBIENTE — RE FUNDING INTELLIGENCE
# NOTA: NESSUN SEGRETO, TOKEN O DATO PERSONALE DEVE ESSERE INSERITO IN QUESTO FILE.
# I destinatari effettivi sono gestiti ESCLUSIVAMENTE all'interno del flusso Power Automate.
# ==============================================================================

# GitHub Repository & Hosting Pages (impostati dall'amministratore GitHub dell'Ente)
GH_OWNER=Osservatorio-Urbano
GH_REPOSITORY=osservatorio-bandi-re
PAGES_BASE_URL=https://osservatorio-urbano.github.io/osservatorio-bandi-re

# Base path Vite per sub-path di GitHub Pages (es. /osservatorio-bandi-re/ o /)
VITE_BASE_PATH=/osservatorio-bandi-re/

# ------------------------------------------------------------------------------
# PARAMETRI OPERATIVI POWER AUTOMATE (Da configurare nel portale Power Automate)
# ------------------------------------------------------------------------------
# Fuso orario di esecuzione Recurrence:
PA_TIMEZONE=W. Europe Standard Time

# Destinatari newsletter settimanale (configurati SOLO nell'azione Send an email V2 in Power Automate):
# Esempio: gruppo interno di distribuzione o lista dirigenti autorizzati
# PA_TO=dirigenti-comune@comune.re.it; taskforce-pnrr@comune.re.it

# Casella tecnica di alert in caso di anomalie o blocco quality gate:
# PA_ADMIN=supporto-sistemi-informativi@comune.re.it
